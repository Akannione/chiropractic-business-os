PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/chiropractic_business_os

# Must be the exact frontend origin. A wrong value here silently blocks the app.
CORS_ORIGIN=https://frontend-gold-alpha-31.vercel.app
PRACTICE_NAME=CBOS Demo Practice

# Setting this switches on staff login for every endpoint except the config,
# auth, public intake, and webhook routes.
ADMIN_PASSWORD=replace-with-a-strong-staff-password

# Required whenever ADMIN_PASSWORD is set, minimum 32 characters, never a
# placeholder. Startup fails rather than issuing forgeable session tokens.
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace-with-openssl-rand-hex-32

# Set to false for a real practice. Leaving it true lets anyone with access
# wipe the collection through /api/demo/reset and refills an empty collection
# with invented patients.
BUSINESS_OS_DEMO_MODE=true

INTERNAL_NOTIFICATION_EMAIL=staff@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chiropractic Business OS <no-reply@example.com>
