PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/chiropractic_business_os
CORS_ORIGIN=http://localhost:5173
PRACTICE_NAME=Chiropractic Practice

# Leave ADMIN_PASSWORD empty to run without staff login. That is the demo
# posture: every endpoint is open, which is fine for fake data and is not
# acceptable once real patient records exist.
ADMIN_PASSWORD=

# Only read when ADMIN_PASSWORD is set. Session tokens are HMACs keyed on this
# value, so a guessable secret means anyone can mint an admin token. The server
# refuses to start if login is enabled with a placeholder or a secret shorter
# than 32 characters. Generate one with: openssl rand -hex 32
AUTH_TOKEN_SECRET=

# Demo mode seeds fake patients into an empty collection and enables the reset
# endpoint. Must be false for any deployment holding real records.
BUSINESS_OS_DEMO_MODE=true

INTERNAL_NOTIFICATION_EMAIL=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chiropractic Business OS <no-reply@example.com>
