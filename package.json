{
  "name": "cbos-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack CBOS workspace.",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:vercel": "npm run build --prefix frontend",
    "check:bundle": "node scripts/check-frontend-bundle.mjs",
    "check:secrets": "node scripts/check-tracked-secrets.mjs",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend && node scripts/test-vercel-routing.mjs",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "smoke:reactivation": "npm --prefix backend run smoke:reactivation --",
    "demo:csv": "npm --prefix backend run demo:csv",
    "bench": "npm --prefix backend run bench",
    "audit:duplicates": "npm --prefix backend run audit:duplicates --",
    "test:db": "npm --prefix backend run test:db",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "test:e2e:cross-browser": "npm run test:e2e:cross-browser --prefix frontend",
    "test:e2e:auth": "npm run test:e2e:auth --prefix frontend",
    "test:e2e:deployment": "npm run test:e2e:deployment --prefix frontend"
  }
}
